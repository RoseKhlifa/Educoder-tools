# ARCHIVED: user chose a single self-hosted Go service; this file is not used.
# Put this server block inside nginx's `http {}` configuration.
# Paths assume the tree generated by tools/static_resources.py + rewrite_origins.py.
# This is a deployment example. The Go legacy-compatible API adapter is required.
server {
    listen 8081;
    server_name localhost;

    root /srv/educoder-reuse/site/www.educoder.net;
    index index.html;
    client_max_body_size 1m;

    # Preserve original /api/... URI and query string: no trailing slash on upstream.
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_buffering off;
        proxy_cache off;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /_assets/www-cdn.educoder.net/ {
        alias /srv/educoder-reuse/site/www-cdn.educoder.net/;
        add_header Cache-Control "public, max-age=3600";
    }

    location ^~ /_assets/ali-cdn.educoder.net/ {
        alias /srv/educoder-reuse/site/ali-cdn.educoder.net/;
        add_header Cache-Control "public, max-age=3600";
    }

    # Do not return the SPA HTML for missing JS/CSS/font/worker files.
    location ~* \.(?:js|mjs|css|png|jpg|jpeg|gif|svg|ico|webp|avif|woff2?|ttf|otf|eot|wasm|webmanifest|map)$ {
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Original browser routes (/users, /classrooms, /tasks) use the original SPA shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
