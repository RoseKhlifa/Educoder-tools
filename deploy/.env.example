# No account/password or upstream cookies belong here.
APP_VERSION=SET_FROM_VERSION
VCS_REF=unknown
# touge.mom is served through HTTPS by the user's 1Panel reverse proxy.
WEB_COOKIE_SECURE=true
WEB_ORIGIN=https://touge.mom
# Verified Educoder numeric user IDs, comma-separated. Empty = no bootstrap admin.
# Never use a phone number, login name or browser-provided role here.
PLATFORM_ADMIN_USER_IDS=
# Optional admission cards; not a payment, pricing or recurring-quota system.
ACCESS_CARD_REQUIRED=false
# Optional in-process async answer service tuning.
JOB_WORKERS=16
JOB_QUEUE_SIZE=256
JOB_PER_ACCOUNT_PENDING=16
JOB_PER_ACCOUNT_RUNNING=4
JOB_TIMEOUT=30m
MODEL_CONCURRENCY=8
MODEL_TIMEOUT=2m
# The installer creates an empty secret when no model key is configured.
DEEPSEEK_SECRET_FILE=/opt/educoder-tools/secrets/deepseek_api_key
