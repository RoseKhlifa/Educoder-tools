# No account/password or upstream cookies belong here.
APP_VERSION=SET_FROM_VERSION
VCS_REF=unknown
# touge.mom is served through HTTPS by the user's 1Panel reverse proxy.
WEB_COOKIE_SECURE=true
# Optional in-process async answer service tuning.
JOB_WORKERS=8
JOB_QUEUE_SIZE=128
JOB_PER_ACCOUNT_PENDING=4
JOB_TIMEOUT=10m
MODEL_CONCURRENCY=2
MODEL_TIMEOUT=2m
# The installer creates an empty secret when no model key is configured.
DEEPSEEK_SECRET_FILE=/opt/educoder-tools/secrets/deepseek_api_key
