{
  "name": "educoder-workbench",
  "version": "0.1.47",
  "private": true,
  "type": "module",
  "description": "Browser TypeScript workbench for the Go Educoder service",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.web.json",
    "test": "npm run build && node web/check.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "web:build": "npm run build",
    "web:check": "npm test"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
